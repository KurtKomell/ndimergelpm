<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>NdiMerger.App</RootNamespace>
    <AssemblyName>NdiMergerLPM</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NdiMerger.Core\NdiMerger.Core.csproj" />
    <ProjectReference Include="..\NdiMerger.Sources\NdiMerger.Sources.csproj" />
    <ProjectReference Include="..\NdiMerger.Output\NdiMerger.Output.csproj" />
    <ProjectReference Include="..\NdiMerger.Tracking\NdiMerger.Tracking.csproj" />
  </ItemGroup>

  <!-- Safety net if WebView2.targets still flows transitively. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Identity)').Contains('WebView2.Wpf'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="NDI\ndi-config.v1.json" Link="NDI\ndi-config.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\**\*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\libs\Processing.NDI.Lib.x64.dll" Link="Processing.NDI.Lib.x64.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- WebView2Loader must sit next to the EXE; the package targets would copy it, but we keep those off to avoid WPF. -->
    <None Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3537.50\runtimes\win-x64\native\WebView2Loader.dll"
          Condition="Exists('$(NuGetPackageRoot)microsoft.web.webview2\1.0.3537.50\runtimes\win-x64\native\WebView2Loader.dll')"
          Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
